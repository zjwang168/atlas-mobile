# Copy to `.env` at the repository root and fill in what you need.
# `.env` is gitignored; this file is not, so never put a real value here.
#
# Only the "core" block is required to boot. Everything below it is gated on
# the feature you are actually running — an unset key disables that path
# rather than breaking the app.

# ---- Core: mobile + backend ------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Atlas AI chat ---------------------------------------------------------
OPENAI_API_KEY_MANGO=
OPENAI_MODEL_MANGO=
OPENAI_BASE_URL_MANGO=

# ---- Discover: local events ------------------------------------------------
# Free, self-service keys. Without them /events still answers, reporting the
# missing source as `not_configured` rather than failing.
# usdalocalfoodportal.com — farmers markets
USDA_API_KEY=
# nps.gov/subjects/developer — National Park Service events
NPS_API_KEY=

# Contact string sent in the User-Agent by
# `python3 -m backend.services.events_service.geocode_curated`, which resolves
# the curated events file's coordinates against OpenStreetMap. Nominatim's
# usage policy requires a way to reach whoever is running the script. Leave
# unset to identify the project by its repository URL; set an email here if
# you would rather they contact a person. Not read by the server at runtime.
NOMINATIM_CONTACT=

# ---- Import pipelines ------------------------------------------------------
# Each import mode needs its own provider; unset ones simply stay unavailable.
# screenshot OCR
GLM_API_KEY=
# visual webpage capture
GEMINI_API_KEY=
GEMINI_COMPUTER_USE_MODEL=
# single-photo place recognition
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Reddit parse pipeline
DEEPSEEK_API_KEY=
# smart-text cascade
QWEN_API_KEY=
GROQ_API_KEY=
# web search routing
TAVILY_API_KEY=

# Social video imports (Apify actors)
APIFY_TOKEN=
TIKTOK_APIFY_ACTOR=
INSTAGRAM_REELS_APIFY_ACTOR=
INSTAGRAM_REELS_METADATA_TIMEOUT_S=
INSTAGRAM_REELS_TRANSCRIPT_TIMEOUT_S=
FACEBOOK_VIDEO_APIFY_ACTOR=
FACEBOOK_REELS_METADATA_TIMEOUT_S=
FACEBOOK_REELS_CAPTIONS_TIMEOUT_S=

# ---- Geocoding providers ---------------------------------------------------
# The backend's geocoder cascades through these; each is optional.
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---- Observability ---------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
